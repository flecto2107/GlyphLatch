<UserControl x:Class="GlyphLatch.Windows.GlyphPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GlyphLatch.Windows">
    <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{DynamicResource Quiet}" Click="CloseClick"
                        Padding="7,0" MinHeight="30" VerticalAlignment="Top" AutomationProperties.Name="Закрыть глифы">
                    <local:LucideIcon Glyph="x" />
                </Button>
                <StackPanel Margin="1,0,5,0">
                    <TextBlock Text="Глифы" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="FaceName" Foreground="{DynamicResource Muted}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <TextBox x:Name="Query" MinHeight="42" Padding="31,5,10,5" FontSize="15" TextChanged="FilterChanged"
                         ToolTip="Введите символ, U+0410 или #12" AutomationProperties.Name="Поиск глифов" />
                <local:LucideIcon Glyph="search" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="QueryHint" Text="Символ, U+0410 или #12" Foreground="{DynamicResource Muted}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="31,0,6,0"
                           TextTrimming="CharacterEllipsis" FontSize="13" />
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,7,0,6">
                <ToggleButton x:Name="AllIds" DockPanel.Dock="Right" Style="{DynamicResource Segment}"
                              Checked="FilterChanged" Unchecked="FilterChanged" AutomationProperties.Name="По ID"
                              ToolTip="Показать глифы без назначенного кода Unicode">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Glyph="hash" Width="13" Height="13" Margin="0,0,4,0" />
                        <TextBlock Text="По ID" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" />
            </DockPanel>
            <Grid Grid.Row="3">
                <ListBox x:Name="Tiles" BorderThickness="0" Background="Transparent"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" IsTabStop="False" AutomationProperties.Name="Сетка глифов">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="PickGlyph" ToolTip="{Binding Label}"
                                                BorderThickness="0" Background="{DynamicResource Hover}"
                                                AutomationProperties.Name="{Binding Label}" Margin="1,1,2,2"
                                                Padding="1,1" Height="55">
                                            <StackPanel>
                                                <local:GlyphMark Entry="{Binding}" Ink="{DynamicResource Ink}" Width="35" Height="32" />
                                                <TextBlock Text="{Binding ShortLabel}" FontSize="9" HorizontalAlignment="Center" FontFamily="{DynamicResource InterfaceCodeFont}"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="CopyGlyph"
                        IsEnabled="False" Padding="8,4" AutomationProperties.Name="Копировать">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Glyph="copy" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Копировать" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="SelectedText" Text="Выберите глиф" Margin="1,0,5,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" FontFamily="{DynamicResource InterfaceCodeFont}" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
